{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability for ShipSignal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    "fs:default",
    "notification:default",
    "os:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "http://*/*" }
      ]
    }
  ]
}